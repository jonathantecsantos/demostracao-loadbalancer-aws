# ==============================================================================
# CONFIGURAÇÃO DA APLICAÇÃO (LOAD BALANCER & FAILOVER DEMO)
# ==============================================================================

# Porta local do servidor web (padrão: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 🎯 MODO ALUNO (Frontend Local apontando para a AWS):
# Cole aqui a URL / DNS do Load Balancer criado no AWS Lightsail fornecido pelo professor
# Exemplo: TARGET_URL=http://lb-aula-demo.xxxxxx.lightsail.amazonaws.com
# (Deixe em branco ou comente caso queira rodar apenas localmente)
# ------------------------------------------------------------------------------
TARGET_URL=

# ------------------------------------------------------------------------------
# ☁️ MODO INSTÂNCIA AWS (Configurado nas instâncias Lightsail pelo professor):
# Identificador amigável da instância exibido no Card
# Exemplos: "Instância A - Lightsail (US-East)", "Instância B - Lightsail (US-East)"
# ------------------------------------------------------------------------------
INSTANCE_NAME=Instância A - Lightsail

# Cor temática da instância na AWS (blue, green, purple, orange, cyan, pink)
# Exemplo: Instância A = blue | Instância B = green
INSTANCE_COLOR=blue
